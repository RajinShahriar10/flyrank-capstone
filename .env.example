# Next.js — public base URL of the app, used by /health to call the API.
# Recommended: set the same value in Vercel's Production and Preview env vars.
# Leave blank locally; /health then derives the origin from request headers.
NEXT_PUBLIC_APP_URL=

# Reserved slot for a future private API key.
# Never set real secrets here — document the name only; provide values via
# Vercel env vars or a local .env file (which is git-ignored).
# EXTERNAL_API_KEY=