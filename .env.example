# Next.js — public base URL of the app, used by /health to call the API.
# Recommended: set the same value in Vercel's Production and Preview env vars.
# Leave blank locally; /health then derives the origin from request headers.
NEXT_PUBLIC_APP_URL=

# Google AI Studio API key for the streaming AI chat (/api/chat). Server-side only —
# the route handler reads it from process.env; it is never sent to the browser.
# Provide the real value via Vercel env vars or a local .env file (git-ignored).
# Free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the model used by /api/chat (default gemini-3.6-flash).
GEMINI_MODEL=